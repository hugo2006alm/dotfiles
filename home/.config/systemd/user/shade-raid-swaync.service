[Unit]
Description=Shade Raid notification center
PartOf=graphical-session.target
BindsTo=hyprland-session.target
After=hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionPathExists=%h/.config/swaync/config.json
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecCondition=/usr/bin/test -x /usr/bin/swaync
ExecStart=/usr/bin/swaync
Restart=on-failure
RestartSec=1
Slice=session.slice
