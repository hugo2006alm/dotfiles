[Unit]
Description=Shade Raid on-screen display
PartOf=graphical-session.target
BindsTo=hyprland-session.target
After=hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionPathExists=%h/.config/swayosd/style.css
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecCondition=/usr/bin/test -x /usr/bin/swayosd-server
ExecStart=/usr/bin/swayosd-server --style %h/.config/swayosd/style.css
Restart=on-failure
RestartSec=1
Slice=session.slice
